# Flask/session
FLASK_SECRET_KEY=replace-with-a-random-secret
OPEN_BROWSER=1
PORT=5000

# Base URL used inside SMTP messages.
# For SMTP open tracking from Gmail, this must be an HTTPS URL
# reachable from the Internet.
#
# Example:
# SIM_BASE_URL=https://your-public-url.example
SIM_BASE_URL=

# SMTP settings for your own authorized test mailbox only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-authorized-test-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-authorized-test-email@gmail.com
SMTP_ALLOWED_RECIPIENT=your-authorized-test-recipient@gmail.com